{
  "name": "next-story",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "npm run tauri dev",
    "tauri:build": "npm run tauri build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:reliability && node --test test/*.test.mjs",
    "test:plugin": "node --test test/*.test.mjs",
    "test:frontend": "node --test tests/*.test.ts",
    "test:reliability": "node --test sidecar/reliability/tests/*.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run typecheck && npm run lint && npm run test:frontend && npm run test:reliability && npm run build && npm run test:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-dialog": "~2.7.1",
    "@tiptap/core": "2.27.2",
    "@tiptap/extension-bold": "2.27.2",
    "@tiptap/extension-bullet-list": "2.27.2",
    "@tiptap/extension-color": "2.27.2",
    "@tiptap/extension-document": "2.27.2",
    "@tiptap/extension-font-family": "2.27.2",
    "@tiptap/extension-heading": "2.27.2",
    "@tiptap/extension-highlight": "2.27.2",
    "@tiptap/extension-history": "2.27.2",
    "@tiptap/extension-italic": "2.27.2",
    "@tiptap/extension-link": "2.27.2",
    "@tiptap/extension-list-item": "2.27.2",
    "@tiptap/extension-ordered-list": "2.27.2",
    "@tiptap/extension-paragraph": "2.27.2",
    "@tiptap/extension-strike": "2.27.2",
    "@tiptap/extension-text": "2.27.2",
    "@tiptap/extension-text-align": "2.27.2",
    "@tiptap/extension-text-style": "2.27.2",
    "@tiptap/extension-underline": "2.27.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "~2.11.4",
    "@types/node": "^26.1.1",
    "eslint": "^10.9.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.67.0",
    "vite": "~6.4.3"
  },
  "description": "Next Story 是一个带 AI 思考辅助的剧本写作桌面编辑器。它希望降低开始创作和获得帮助的前置门槛，把认真讲述自己故事的权利交给每一个想创作的人。",
  "main": "eslint.config.js",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irisnb/next-story.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/irisnb/next-story/issues"
  },
  "homepage": "https://github.com/irisnb/next-story#readme"
}
